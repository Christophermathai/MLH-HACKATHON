# Global local development configuration
# Copy to app/api/.env and app/frontend/.env.local as needed

# Gateway (app/api)
PORT=8787
HOST=127.0.0.1
PROVIDER_MODE=mock
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live provider credentials (required ONLY when PROVIDER_MODE=live)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Frontend (app/frontend)
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://127.0.0.1:8787
NEXT_PUBLIC_GATEWAY_WS_URL=ws://127.0.0.1:8787/ws
